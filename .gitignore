# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/
.python-version

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
._*
Thumbs.db

# Logs
*.log

# Environment variables
.env

# Generated indexes (rebuilt by indexing)
data/chroma_db/
data/tags.db

# User files to index — personal data, never commit (folder kept via .gitkeep)
data/sample_files/*
!data/sample_files/.gitkeep

# Model caches (HuggingFace / sentence-transformers / CLIP)
.cache/
.huggingface/
models/

# Streamlit local config
.streamlit/

# Temporary files
tmp/
temp/

# Jupyter checkpoints
.ipynb_checkpoints/

# Python build files
build/
dist/
*.egg-info/

# Test / coverage output
.coverage
coverage/
htmlcov/
